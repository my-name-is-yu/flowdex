{
  "version": "flowdex.workflow.v1",
  "manifest": {
    "name": "hello-host-command",
    "maxAgents": 2,
    "maxConcurrency": 1,
    "permissions": {
      "read": ["**"],
      "write": [],
      "hostCommands": [
        {
          "id": "hello",
          "argv": ["printf", "42\n"],
          "cwd": "project"
        }
      ],
      "network": "none",
      "env": { "inherit": [] }
    },
    "phases": [{ "id": "test", "maxAgents": 1 }]
  },
  "steps": [
    {
      "type": "hostCommand",
      "id": "hello.run",
      "phase": "test",
      "commandId": "hello"
    },
    {
      "type": "claim",
      "id": "hello-command-completed",
      "claim": {
        "id": "hello-command-completed",
        "text": "The hello host command completed.",
        "kind": "verification",
        "confidence": "high",
        "evidence": [
          {
            "type": "command",
            "artifactId": { "$result": "hostCommand:hello.run", "path": ["data", "stdoutArtifactId"] },
            "command": ["printf", "42\n"],
            "exitCode": { "$result": "hostCommand:hello.run", "path": ["data", "exitCode"] }
          }
        ]
      }
    },
    {
      "type": "report",
      "id": "final",
      "value": {
        "title": "Hello host command",
        "claimIds": ["hello-command-completed"]
      }
    }
  ]
}
