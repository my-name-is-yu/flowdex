{
  "name": "flowdex",
  "version": "0.1.0",
  "description": "Runtime-backed workflow orchestration for Codex-style sub-agent fanout",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/my-name-is-yu/flowdex.git"
  },
  "homepage": "https://github.com/my-name-is-yu/flowdex#readme",
  "bugs": {
    "url": "https://github.com/my-name-is-yu/flowdex/issues"
  },
  "bin": {
    "flowdex": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "skills",
    "examples",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "check": "npm run typecheck && npm run test"
  },
  "keywords": [
    "workflow",
    "codex",
    "agents"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
